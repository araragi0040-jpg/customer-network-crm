function seedSampleData() {
  ensureStructure_();
  var ui = SpreadsheetApp.getUi();
  var answer = ui.alert('サンプルデータ投入', '人物28人・紹介関係36件などのサンプルで既存データを置き換えます。よろしいですか？', ui.ButtonSet.YES_NO);
  if (answer !== ui.Button.YES) return;
  var ss = spreadsheet_();
  var names = ['人物マスタ','紹介関係','サービス候補','次回アクション'];
  for (var i = 0; i < names.length; i++) clearData_(ss.getSheetByName(names[i]));
  for (var p = 0; p < CRM_SAMPLE_DATA.people.length; p++) appendObject_(ss.getSheetByName('人物マスタ'), CRM_SAMPLE_DATA.people[p]);
  for (var r = 0; r < CRM_SAMPLE_DATA.relationships.length; r++) appendObject_(ss.getSheetByName('紹介関係'), CRM_SAMPLE_DATA.relationships[r]);
  for (var s = 0; s < CRM_SAMPLE_DATA.services.length; s++) appendObject_(ss.getSheetByName('サービス候補'), CRM_SAMPLE_DATA.services[s]);
  for (var a = 0; a < CRM_SAMPLE_DATA.actions.length; a++) appendObject_(ss.getSheetByName('次回アクション'), CRM_SAMPLE_DATA.actions[a]);
  ui.alert('サンプルデータを投入しました。');
}
